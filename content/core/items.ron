// Core items — bells per doc 02 §8, heals per §15, the v1.6 item pass
// (TMs, vitamins, Mute Charm, special bells, held items). Pockets per
// roadmap P4 ("Bag pockets final").
ItemSet(
    items: [
        // Bells (pocket: Bells). Badge gating lives in mart tables.
        (id: "fermata", name_key: "item.fermata", kind: Bell(catch_mod: (1, 1)), price: 200, pocket: Bells),
        (id: "grand_fermata", name_key: "item.grand_fermata", kind: Bell(catch_mod: (3, 2)), price: 600, pocket: Bells),

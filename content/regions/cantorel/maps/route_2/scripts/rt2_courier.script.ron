[
    If(flag: "trainer.rt2_courier.defeated",
       then: [If(flag: "story.door.seen",
                 then: [Say(who: "rt2_courier", key: "rt2.courier.after.recontext")],
                 else: [Say(who: "rt2_courier", key: "rt2.courier.after")]),
              End],
       else: []),
    Say(who: "rt2_courier", key: "rt2.courier.intro"),
    StartBattle(trainer: "rt2_courier"),
    End,
]

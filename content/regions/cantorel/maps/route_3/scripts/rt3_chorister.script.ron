[
    If(flag: "trainer.rt3_chorister.defeated",
       then: [If(flag: "story.door.seen",
                 then: [Say(who: "rt3_chorister", key: "rt3.chorister.after.recontext")],
                 else: [Say(who: "rt3_chorister", key: "rt3.chorister.after")]),
              End],
       else: []),
    Say(who: "rt3_chorister", key: "rt3.chorister.intro"),
    StartBattle(trainer: "rt3_chorister"),
    End,
]

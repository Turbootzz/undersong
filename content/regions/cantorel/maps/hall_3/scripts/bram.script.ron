// Maestro Bram — Hall 3, the first DOUBLES maestro (beat 5).
[
    If(flag: "hall.3.cleared",
       then: [Say(who: "bram", key: "hall3.bram.after"), End],
       else: []),
    Say(who: "bram", key: "hall3.bram.intro"),
    StartBattle(trainer: "maestro_bram"),
    If(flag: "hall.3.cleared",
       then: [
            Say(who: "bram", key: "hall3.bram.badge"),
            SetFlag(flag: "badge.3"),
            SetFlag(flag: "performance.tunneling_bass"),
            Say(who: "bram", key: "hall3.bram.tunneling"),
       ],
       else: []),
    End,
]

[
    If(flag: "anchor_echo.8", then: [Say(who: "echo_keeper_8", key: "echo8.done"), End], else: []),
    If(flag: "badge.8", then: [], else: [Say(who: "echo_keeper_8", key: "echo8.locked"), End]),
    Say(who: "echo_keeper_8", key: "echo8.ask"),
    Say(who: "echo_keeper_8", key: "echo8.story"),
    StartBattle(trainer: "echo8_warden"),
    If(flag: "trainer.echo8_warden.defeated",
       then: [
            SetFlag(flag: "anchor_echo.8"),
            Say(who: "echo_keeper_8", key: "echo8.grant"),
       ],
       else: []),
    End,
]

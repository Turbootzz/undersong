    "npc.echo_keeper_4": "Keeper Watt",
    "npc.echo_keeper_5": "Keeper Sedge",
    "npc.echo_keeper_6": "Keeper Cairn",
    "npc.echo_keeper_7": "Keeper Rime",
    "npc.echo_keeper_8": "Keeper Octave",
    "npc.fen_elder": "Elder Rush",
    "npc.frost_archivist": "Archivist Neve",
    "npc.hall4_coiler": "Coiler Brand",
    "npc.hall4_winder": "Winder Tess",
    "npc.hall5_prompter": "Prompter Quil",
    "npc.hall5_usher": "Usher Faye",
    "npc.hall6_mason": "Mason Hew",
    "npc.hall7_carver": "Carver Sten",
    "npc.hall7_skater": "Skater Lumi",
    "npc.hall8_registrar": "Registrar Veil",
    "npc.hush": "Hush",
    "npc.ilva": "Maestro Ilva",
    "npc.maren": "Maestro Maren",
    "npc.narrator": "-",
    "npc.orsk": "Maestro Orsk",
    "npc.quartet_1": "Quartet Helia",
    "npc.quartet_3": "Quartet Bron",
    "npc.quartet_4": "Quartet Sere",
    "npc.quartet_bron": "Quartet Bron",
    "npc.quartet_helia": "Quartet Helia",
    "npc.quartet_sere": "Quartet Sere",
    "npc.reed_capital": "Professor Reed",
    "npc.rhea": "Maestro Rhea",
    "npc.rt5_foreman": "Foreman Crick",
    "npc.rt5_linesman": "Linesman Joule",
    "npc.rt5b_bogger": "Bogger Moss",
    "npc.rt5b_lampman": "Lampman Wick",
    "npc.rt6_envoy": "Envoy Mara",
    "npc.rt6_virtuoso": "Virtuoso Anse",
    "npc.vault_guard_1": "Honor Guard Prim",
    "npc.vault_guard_2": "Honor Guard Vox",
    "npc.vesper": "Vesper",
    "npc.volt_worker": "Lineman Pyl",
    "plea.1": "Cade: Hey. Hey. Before tomorrow - I know. About the seat. About what winning IS.",
    "plea.2": "Cade: Let me win. Please. If it has to be someone - let it be the one who was always second anyway.",
    "plea.3": "Cade: …You're going to try your hardest no matter what I say. I know. Page one, that's you. Page one.",
    "plea.after": "Cade: Tomorrow, then. Bring everything. I'd hate the version where you didn't.",
    "plea.early": "Cade: Big city! Terrible kettle situation! Go get your eighth, I'm pacing!",
    "quartet.1.after": "Helia: Four bars was generous. You needed two.",
    "quartet.1.carry": "Helia: I carry it by playing louder than the thought. Your turn.",
    "quartet.1.defeat": "Helia: …Belong, then.",
    "quartet.1.intro": "Helia: First movement! I'll know in four bars if you belong here.",
    "quartet.2.after": "Cade: The box is filled in now. It says 'try anyway'. Go.",
    "quartet.2.carry": "Cade: I asked you to throw it. You won't. Okay. OKAY. Then neither will I.",
    "quartet.2.defeat": "Cade: …It had to be you. It always had to be you.",
    "quartet.2.intro": "Cade: Semifinal. Notebook's last page. It just says your name and a box I never filled in.",
    "quartet.3.after": "Bron: Yielded. Like everything.",
    "quartet.3.carry": "Bron: The mountain taught me everything yields. I hoped the schedule would too. It doesn't.",
    "quartet.3.defeat": "Bron: One more measure. Just one more measure…",
    "quartet.3.intro": "Bron: Third movement. I carry it by not thinking past the next measure. Don't make me think.",
    "quartet.4.after": "Sere: Her part is yours now. I'm sorry. I'm so sorry.",
    "quartet.4.carry": "Sere: You've read the ledger. You're climbing anyway. That's either the bravest or the saddest thing I've seen from this chair.",
    "quartet.4.defeat": "Sere: Stay. Stay up here. Please.",
    "quartet.4.intro": "Sere: Final movement. I knew a Soloist once. I play her part now, every night, so somebody does.",
    "quartet.wait": "The stage above is not yours yet. Finish this one.",
    "reed.chorus_ready": "Reed: It's enough. Score and echoes both. If there was ever a third way down there - you're carrying it.",
    "reed.chorus_track": "Reed: Your Score and the keepers' echoes - I'm tracking both. Not enough yet for the third way. Keep transcribing. Keep listening.",
    "reed.small_talk": "Reed: Cantorel's biggest stage and the kettles are still bad. How are you keeping?",
    "roster.1": "A ledger, hand-copied: THE ROSTER. Every Soloist for three hundred years. Two columns: Ascended. Faded.",
    "roster.2": "The dates between columns: six years. Nine. Seven. Six. The last row reads only: ARIA - twelve years, holding.",
    "roster.3": "You notice, too late to unnotice: the room you are reading this in has no music.",
    "rt5.foreman.after": "Clock out, kid. You earned it.",
    "rt5.foreman.defeat": "Overtime, then.",
    "rt5.foreman.intro": "Shift's not over till someone clocks YOU out.",
    "rt5.linesman.after": "Stay off the third rail.",
    "rt5.linesman.defeat": "Breaker tripped!",
    "rt5.linesman.intro": "Grid runs on discipline. So does my team.",
    "rt5b.bogger.after": "Dry socks are a lie out here.",
    "rt5b.bogger.defeat": "Sunk, fair and square.",
    "rt5b.bogger.intro": "The fen keeps what slips. Mind your footing!",
    "rt5b.lampman.after": "Follow my lamps, not the pretty ones.",
    "rt5b.lampman.defeat": "Snuffed!",
    "rt5b.lampman.intro": "I light the safe path. You're off it.",
    "rt6.envoy.after": "Measurements forwarded. Make of that what you will.",
    "rt6.envoy.defeat": "Noted. All of it.",
    "rt6.envoy.intro": "Conservatory business. Stand and be measured.",
    "rt6.virtuoso.after": "You'd take first chair anywhere.",
    "rt6.virtuoso.defeat": "Bravissimo…",
    "rt6.virtuoso.intro": "Cadenza road! Every step an audition!",
    "spire.locked": "The Spire doors read your Programme: eight clefs or none. Come back complete.",
    "stage.1": "The Soloist's stage. Empty. It was always going to be empty.",
    "stage.2": "The floor opens. Below: stairs, and the sound of the world getting quieter.",
    "tacet.1": "Vesper cuts. The lattice parts like a held breath finally let go - and the world's volume drops by one voice, everywhere, forever.",
    "tacet.2": "Aria wakes in silence. Free. The cost posts later, a little from every song. TACET's cover story was never a cover.",
    "vault.g1.defeat": "Prim: …Then let it be personal. Go down.",
    "vault.g1.intro": "Prim: Honor guard. You understand - it isn't personal. It's arithmetic.",
    "vault.g2.defeat": "Vox: …Witness it, then. Somebody unbought should.",
    "vault.g2.intro": "Vox: Beyond me is the seal. Beyond the seal is the cost. Last chance to climb.",
    "vault.hush.after": "Hush: She's below. Both of them are. The one who asks, and the one who holds.",
    "vault.hush.intro": "Hush: Small world, and getting quieter. We're both using the same door tonight.",
    "vesper.1": "Vesper: So. The knife arrives, still deciding whether it's a battery.",
    "vesper.2": "Vesper: The Roster. The decay curve. The lattice. Aria. You've seen every card now; I've never once lied to you.",
    "vesper.3": "Vesper: The Conservatory needs you as a battery. I need you as a knife. I will at least ask.",
    "vesper.4": "Vesper: She's through there. Whatever you choose - choose it looking at her.",
    "volt.talk": "Pyl: Hall's got a basement door nobody uses. Maintenance, they say. Forty years I've never seen a janitor.",
    "volt.talk.recontext": "Pyl: …You went down there, didn't you. Yeah. 'Maintenance.' Forty years I didn't WANT to see the janitor.",
    "encore.coda": "Reprise: The CODA. Ring it once, keep anything. We only ever mint one per streak - make it count.",
    "encore.done": "Reprise: Seven for seven stands forever. The house still talks about it.",
    "encore.final": "Reprise: Curtain call. Seven of seven. Everything you have, please - the house is listening.",
    "encore.intro": "Reprise: Seven calls, one streak, no intermission you don't earn. First call - begin!",
    "encore.locked": "The Encore seats ticket-holders only - and the only ticket is an ending. Come back when the curtain has fallen once.",
    "encore.next": "Reprise: Held! Next call when you're ready. The streak remembers even if you sleep.",
    "encore.reset": "Reprise: Dropped! The programme restarts from the top. That's what 'encore' MEANS, dear.",
    "map.encore_hall": "The Encore",
    "npc.encore_1": "Encore: Opening Night",
    "npc.encore_2": "Encore: The Mist Set",
    "npc.encore_3": "Encore: The Mountain Set",
    "npc.encore_4": "Encore: The Grid Duet",
    "npc.encore_5": "Encore: The Capital Set",
    "npc.encore_6": "Encore: The Long Programme",
    "npc.encore_7": "Encore: Curtain Call",
    "npc.encore_marshal": "Marshal Reprise",
    "static.cantavella": "At the summit cairn, the wind arranges itself into a rising third - a question, asked directly at you.",
    "static.intervallia": "The silent water folds back. Something old surfaces between two notes that were never played here.",
    "static.primavoce": "On the empty stage, the first voice answers the Chorus - the root the world tunes against, waiting to meet yours.",
    "static.taciturn": "Below the bottom stair, the rest between all rests turns over. It has noticed you noticing.",
    "vesper.rematch": "Vesper: All cards played, every one face up. So - one honest match, knife-free. I never did show you MY hand.",
    "vesper.rematch.defeat": "Vesper: …A chorus. I only ever heard solos. You've heard me say it before; now I believe it.",
    "npc.ferryman": "Ferryman Ode",
    "skald.ferry.locked": "Ode: Boat goes when the song holds steady. It doesn't, yet. You'd know more about that than me, I reckon.",
    "skald.ferry.out": "Ode: Borders open, song willing. Skalden, then - mind the gulls, they steal refrains.",
}
